<clickhouse>
    <!-- Keep diagnostics useful without allowing system logs to dominate a small destination host. -->
    <logger>
        <level>information</level>
        <size>50M</size>
        <count>3</count>
    </logger>

    <query_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </query_log>
    <trace_log>
        <ttl>event_date + INTERVAL 1 DAY DELETE</ttl>
    </trace_log>
    <part_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </part_log>
    <background_schedule_pool_log>
        <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
    </background_schedule_pool_log>
    <text_log>
        <level>information</level>
        <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
    </text_log>
    <metric_log>
        <collect_interval_milliseconds>10000</collect_interval_milliseconds>
        <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
    </metric_log>
    <error_log>
        <ttl>event_date + INTERVAL 14 DAY DELETE</ttl>
    </error_log>
    <asynchronous_metric_log>
        <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
    </asynchronous_metric_log>
    <processors_profile_log>
        <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
    </processors_profile_log>
</clickhouse>
